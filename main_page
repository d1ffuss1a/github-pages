<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Правила ZWorld | Официальный сайт</title>
    <style>
        :root {
            --primary: #0066ff;
            --secondary: #00e1ff;
            --accent: #ff4757;
            --bg: #f8fbff;
            --text: #2d3436;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Futura', sans-serif;
        }

        body {
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        .parallax-bg {
            position: fixed;
            width: 100vw;
            height: 100vh;
            background: 
                linear-gradient(45deg, var(--primary) 0%, var(--secondary) 100%);
            z-index: -2;
            opacity: 0.1;
        }

        .floating-circles div {
            position: fixed;
            border-radius: 50%;
            background: rgba(0, 102, 255, 0.05);
            z-index: -1;
            animation: float 20s infinite linear;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            25% { transform: translate(10vw, 10vh); }
            50% { transform: translate(-5vw, 15vh); }
            75% { transform: translate(-10vw, -5vh); }
        }

        header {
            padding: 6rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .header-content {
            max-width: 800px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        h1 {
            font-size: 4rem;
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 10px 30px rgba(0, 102, 255, 0.15);
            animation: textGlow 3s ease-in-out infinite alternate;
        }

        @keyframes textGlow {
            from { filter: drop-shadow(0 0 10px rgba(0, 102, 255, 0.3)); }
            to { filter: drop-shadow(0 0 20px rgba(0, 102, 255, 0.5)); }
        }

        nav {
            position: fixed;
            left: 2rem;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.9);
            padding: 1.5rem;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
        }

        nav a {
            display: block;
            margin: 1rem 0;
            color: var(--text);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        nav a:hover {
            background: var(--primary);
            color: white;
            transform: translateX(10px);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
        }

        .section {
            background: white;
            border-radius: 20px;
            padding: 3rem;
            margin: 3rem 0;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transform: translateY(50px);
            opacity: 0;
            transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .section.visible {
            transform: translateY(0);
            opacity: 1;
        }

        .rule-number {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 1rem;
            position: relative;
            padding-left: 2rem;
        }

        .rule-number::before {
            content: ' ❖';
            position: absolute;
            left: -10;
            top: 40%;
            transform: translateY(-50%);
            width: 1.2rem;
            height: 1.2rem;
            background: ;
            border-radius: 50%;
        }

        .rule-content {
            line-height: 1.8;
            margin-left: 2rem;
            border-left: 3px solid var(--primary);
            padding-left: 1.5rem;
        }

        .highlight {
            color: var(--accent);
            font-weight: 600;
        }

        .penalty {
            display: inline-block;
            background: rgba(255, 71, 87, 0.1);
            color: var(--accent);
            padding: 0.3rem 0.8rem;
            border-radius: 5px;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }
        .penalty2 {
            display: inline-block;
            background: rgba(170, 254, 255, 0.2);
            color: green;
            padding: 0.3rem 0.8rem;
            border-radius: 5px;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            nav {
                display: none;
            }
            
            h1 {
                font-size: 2.5rem;
            }
            
            .section {
                padding: 2rem;
            }
        }

        .footer {
            text-align: center;
            padding: 3rem;
            color: rgba(45, 52, 54, 0.7);
        }
    </style>
</head>
